# Copy to .env.local and fill in values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# --- Supabase (Auth + DB + RLS) ---
# Project URL: Dashboard → Project Settings → API (or Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=
# Public client key (pick ONE approach):
# • New hosted keys: Publishable "sb_publishable_…" → NEXT_PUBLIC_SUPABASE_ANON_KEY (recommended)
#   OR set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (app reads it if ANON is empty)
# • Legacy: JWT anon "eyJ…" from Legacy API Keys tab → NEXT_PUBLIC_SUPABASE_ANON_KEY
# Never put service_role / sb_secret_ in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Auth: add http://localhost:3000/auth/callback (and prod URL) under
# Authentication → URL configuration → Redirect URLs. Site URL = app origin.

# Server only: enrollment after Razorpay verify, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
# Server: create order + verify signature
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Client: Checkout.js (publishable key id only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — keep secrets out of git; commit `.env.example` as a template if you add one
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# typescript (keep next-env.d.ts tracked — Next generates it for types)
*.tsbuildinfo

# caches & tooling
.turbo
.eslintcache

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / editors
.cursor/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
logs
*.log

# Playwright (if added later)
/test-results/
/playwright-report/
/blob-report/

# Supabase local (if you use CLI linked branches)
.branches
.temp
